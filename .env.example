# Copy this file to .env only if you want a local reference. ResortBook reads its
# setting at BUILD time, not from a .env file:
#
#   flutter run -d chrome --dart-define=POCKETBASE_URL=http://127.0.0.1:8090
#   flutter build web --release --dart-define=POCKETBASE_URL=https://your-pocketbase.example.com
#
# .env is git-ignored. Never commit real credentials.

# --- Safe to ship in the app -------------------------------------------------
# The PocketBase address. Default (development): http://127.0.0.1:8090
# For GitHub Pages, set the same name as a repository VARIABLE (Settings >
# Secrets and variables > Actions > Variables), not a secret.
POCKETBASE_URL=http://127.0.0.1:8090

# --- NEVER ship or commit ----------------------------------------------------
# The PocketBase superuser (admin) email/password, API tokens and hosting
# credentials stay on your machine / hosting dashboard. They are not used by the app.